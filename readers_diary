diary = [] #Список для книг
while True:
    print("=====Читательский Дневник=====") 
    print("Я умею делать такие вещи как: ")
    print("1 - Добавить книгу") 
    print("2 - Показать все книги")
    print("3 - Показать последние 5 книг")
    print("4 - Заменить название книги")
    print("5 - поиск по по числу в хранилище")
    print("6 - Статистика") 
    print("0 - Выход")
    operation = int(input("Выберете операцию: "))
    if operation == 0: # Операция 0 - вежливо прощаеться с пользователем и завершает программу
        print("Досвидания !")
        break
    elif operation == 1: # Операция 1 - через команду append добавляет название книг в список + записывает их с заглавной буквы 
        name_book = input("Введите название книги: ")
        diary.append(name_book.capitalize())
    elif operation == 2: # Операция 2 - показывает список (Все книиги)
        print(diary)
    elif operation == 3: # Операция 3 - показывает последние 5 книг в списке 
        print(diary[-5:])
    elif operation == 4: # Операция 4 - заменяет через индекс названия книг
        change1 = input("Введите книгу на замену: ")
        change2 = input("Введите книгу для замены: ")
        diary[diary.index(change1)] = change2
    elif operation == 5: # Операция 5 - находит книги по порядку цифр (выбераешь число и программа выдает тебе по цифре название книги )
        find_book = int(input("Введите названия книги которую хотите найти по порядку в хранилище: "))
        print(diary[find_book - 1])
    elif operation == 6: # Операция 6 - Показывает последние 2 книги 
        print("Статистика: ")
        print("Это все книги которые были добавлены самыми последнеми: ")
        print(diary[-2:])
    else:
        print("Операция не найдена !")
